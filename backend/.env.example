# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PhonePe Standard Checkout (server-side only; never expose these in Vite)
# Set PHONEPE_ENABLED=true only after every value below is configured in the
# corresponding PhonePe sandbox or production dashboard.
PHONEPE_ENABLED=false
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
# Configure PhonePe's SHA webhook authentication with these same two values.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# PhonePe checkout lifetime, in seconds (60–3600).
PHONEPE_PAYMENT_EXPIRY_SECONDS=1200

# Pine Labs Online hosted checkout (server-side only; never expose these in Vite)
# Keep disabled until Pine Labs gives you PG—not Pine One/POS—credentials and
# registers the webhook URL in their onboarding system.
PINELABS_ENABLED=false
PINELABS_ENV=sandbox
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
# Base64-encoded webhook secret from Pine Labs Online Dashboard → Settings.
PINELABS_WEBHOOK_SECRET=
# Pine Labs verifies webhook timestamps; 300 seconds is the safe default.
PINELABS_WEBHOOK_TOLERANCE_SECONDS=300
# Comma-separated subset of CARD,UPI,NETBANKING,WALLET,CREDIT_EMI,DEBIT_EMI,BNPL,POINTS.
PINELABS_ALLOWED_PAYMENT_METHODS=UPI,CARD,NETBANKING

# Pine Labs POS transaction reporting (server-side admin reconciliation only).
# This is a separate product from Pine Labs Online Payments / Plural checkout.
PINELABS_POS_REPORTING_ENABLED=false
PINELABS_POS_API_BASE_URL=https://api-c.pinelabs.com
PINELABS_POS_CLIENT_ID=
PINELABS_POS_CLIENT_SECRET=
PINELABS_POS_REQUEST_TIMEOUT_MS=15000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
