# Copy this file to deploy/.env on the VPS. Never commit deploy/.env.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://www.restoralai.com,https://restoralai.com

PHONEPE_ENABLED=false
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PHONEPE_PAYMENT_EXPIRY_SECONDS=1200

# Pine Labs Online Payments / Plural hosted checkout (not Pine One POS APIs)
# Do not switch this on until Pine Labs has registered the production webhook
# URL and supplied all three production values below.
PINELABS_ENABLED=false
PINELABS_ENV=production
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_WEBHOOK_SECRET=
PINELABS_WEBHOOK_TOLERANCE_SECONDS=300
PINELABS_ALLOWED_PAYMENT_METHODS=UPI,CARD,NETBANKING

# Pine Labs POS transaction reporting. This only powers the admin-only
# reconciliation endpoint; it does not process checkout payments.
PINELABS_POS_REPORTING_ENABLED=false
PINELABS_POS_API_BASE_URL=https://api-c.pinelabs.com
PINELABS_POS_CLIENT_ID=
PINELABS_POS_CLIENT_SECRET=
PINELABS_POS_REQUEST_TIMEOUT_MS=15000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
